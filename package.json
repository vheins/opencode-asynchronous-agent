{
  "name": "@vheins/opencode-asynchronous-agent",
  "version": "0.12.0",
  "description": "OpenCode plugin (V1 + V2): runs every subagent asynchronously in the background, a TUI sidebar monitor with token stats, opt-in background-subagent control tools (children/result/cancel/send), opt-in event-driven progress reports from a child's todowrite to its parent, and an opt-out V1 database cleanup that caps tool output and prunes stale event/part rows.",
  "type": "module",
  "main": "./server.js",
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload @opentui/solid/preload"
  },
  "exports": {
    ".": "./server.js",
    "./server": "./server.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "server.js",
    "index.js",
    "src",
    "dist",
    "LICENSE-monitor",
    "README-monitor.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v1",
    "opencode-v2",
    "subagent",
    "background",
    "async",
    "agent",
    "tui",
    "sidebar",
    "statusline"
  ],
  "license": "MIT",
  "author": "vheins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vheins/opencode-asynchronous-agent.git"
  },
  "homepage": "https://github.com/vheins/opencode-asynchronous-agent#readme",
  "bugs": {
    "url": "https://github.com/vheins/opencode-asynchronous-agent/issues"
  },
  "engines": {
    "opencode": ">=1.18.0",
    "node": ">=22.13"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.4.0 <0.6",
    "@opentui/solid": ">=0.4.0 <0.6",
    "solid-js": ">=1.9.12 <2"
  },
  "peerDependenciesMeta": {
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.34",
    "@opentui/core": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "@types/bun": "^1.3.0",
    "solid-js": "1.9.12",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
