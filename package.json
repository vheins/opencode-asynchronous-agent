{
  "name": "@vheins/opencode-asynchronous-agent",
  "version": "0.3.2",
  "description": "OpenCode plugin (V1 + V2): runs every subagent asynchronously in the background, plus a TUI sidebar monitor with token/TPS stats and a collapsed-sidebar status bar.",
  "type": "module",
  "main": "./server.js",
  "exports": {
    ".": "./server.js",
    "./server": "./server.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "server.js",
    "index.js",
    "src",
    "dist",
    "LICENSE-monitor",
    "README-monitor.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v1",
    "opencode-v2",
    "subagent",
    "background",
    "async",
    "agent",
    "tui",
    "sidebar",
    "statusline"
  ],
  "license": "MIT",
  "author": "vheins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vheins/opencode-asynchronous-agent.git"
  },
  "homepage": "https://github.com/vheins/opencode-asynchronous-agent#readme",
  "bugs": {
    "url": "https://github.com/vheins/opencode-asynchronous-agent/issues"
  },
  "engines": {
    "opencode": ">=1.18.0",
    "node": ">=22.13"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.4.0 <0.6",
    "@opentui/solid": ">=0.4.0 <0.6",
    "solid-js": ">=1.9.12 <2"
  },
  "peerDependenciesMeta": {
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  },
  "publishConfig": {
    "access": "public"
  }
}
